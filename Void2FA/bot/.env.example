# Copy outside Git, chmod 600. Never paste real values into issues or chat.
# Bothost: BOT_TOKEN is injected by the panel; add BRIDGE_SHARED_SECRET in Environment Variables.
BOT_TOKEN=
BRIDGE_SHARED_SECRET=
# Bothost provides DATA_DIR=/app/data and PORT when the domain option is enabled.
DATA_DIR=/app/data
PORT=8080
HOST=0.0.0.0
# Alternatives for Docker/systemd secrets:
# BOT_TOKEN_FILE=/run/secrets/bot_token
# BRIDGE_SHARED_SECRET_FILE=/run/secrets/bridge_secret
# BOT_STATE_PATH=/var/lib/voidsmp-bot/bot.sqlite3

# Необязательно. Нужно, только если контейнер не достаёт api.telegram.org напрямую
# (в логах "HTTP 0"). Сначала попробуй в профиле Bothost «Зарубежный IP для API и нейросетей»
# и сделай повторный деплой. Прокси — запасной вариант.
# TELEGRAM_PROXY=http://user:pass@host:port
# TELEGRAM_PROXY=socks5://user:pass@host:port   # требует aiohttp-socks в requirements.txt
# Своё зеркало Bot API вместо прокси:
# TELEGRAM_API=https://tg-api.example.org
