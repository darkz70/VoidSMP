{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:custom_model_data",
    "index": 0,
    "fallback": {
      "type": "minecraft:model",
      "model": "minecraft:item/note_block"
    },
    "cases": [
      {
        "when": "sculk_log",
        "model": {
          "type": "minecraft:model",
          "model": "voidquirks:item/sculk_log"
        }
      },
      {
        "when": "sculk_leaves",
        "model": {
          "type": "minecraft:model",
          "model": "voidquirks:item/sculk_leaves"
        }
      },
      {
        "when": "sculk_planks",
        "model": {
          "type": "minecraft:model",
          "model": "voidquirks:item/sculk_planks"
        }
      }
    ]
  }
}
