{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:custom_model_data",
    "fallback": {
      "type": "minecraft:model",
      "model": "minecraft:item/diamond_sword"
    },
    "cases": [
      {
        "when": "void_saber_light",
        "model": { "type": "minecraft:model", "model": "minecraft:item/void_saber_light" }
      },
      {
        "when": "void_saber_dark",
        "model": { "type": "minecraft:model", "model": "minecraft:item/void_saber_dark" }
      }
    ]
  }
}
